DATABASE_URL=postgresql://user:password@host:5432/swarmangal

# Flutter app device tokens (long random strings; rotate by changing these).
RPC_FOUNDER_TOKEN=replace-with-long-random-founder-token
RPC_STAFF_TOKEN=replace-with-long-random-staff-token

# Branches the STAFF token may read and write. Required: if this is unset,
# the staff app sees no branch data at all (fail closed). Founder sees all.
RPC_STAFF_BRANCHES=GOREGAON,KANDIVALI

# Legacy web app logins. Each must be at least 12 characters, and an account
# left on an old default password is locked on boot. Omit both to keep the
# web logins disabled.
ADMIN_PASSWORD=replace-with-strong-admin-password
STAFF_PASSWORD=replace-with-strong-staff-password
NEXT_PUBLIC_AUTH_ENABLED=true
SESSION_SECRET=replace-with-random-hex-at-least-32-chars
